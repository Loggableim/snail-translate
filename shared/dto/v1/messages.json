{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snail-translate.github.io/dto/v1/messages.json",
  "title": "Snail Message DTOs",
  "description": "Versioned message types shared between Flutter client and Cloudflare Worker.",
  "version": "1.0.0",
  "protocolVersion": 1,
  "definitions": {
    "MessageType": {
      "type": "string",
      "enum": [
        "auth", "auth_ok", "auth_error",
        "chat", "voice",
        "edit", "delete",
        "signal",
        "ping",
        "chat_history", "delivery_ack",
        "peer_joined", "peer_left", "session_end",
        "subtitle", "listener_joined", "listener_left", "listener_kick", "listener_kicked",
        "contact_request", "contact_response",
        "error"
      ]
    },
    "AuthMessage": {
      "type": "object",
      "required": ["type", "token", "protocolVersion"],
      "properties": {
        "type": { "const": "auth" },
        "token": { "type": "string", "minLength": 1 },
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "agreementPublicKey": {
          "type": "string",
          "description": "base64-encoded X.509 P-256 public key for ECDH"
        }
      }
    },
    "PeerJoinedMessage": {
      "type": "object",
      "required": ["type", "peerId"],
      "properties": {
        "type": { "const": "peer_joined" },
        "peerId": { "type": "string", "minLength": 1 },
        "peerAgreementPublicKey": {
          "type": "string",
          "description": "base64-encoded X.509 P-256 public key for ECDH"
        }
      }
    },
    "ChatMessage": {
      "type": "object",
      "required": ["type", "messageId", "text", "timestamp"],
      "properties": {
        "type": { "const": "chat" },
        "messageId": { "type": "string", "format": "uuid" },
        "text": {
          "type": "string",
          "maxLength": 10000,
          "description": "plaintext for legacy entries or snail-chat-v1 AES-GCM envelope"
        },
        "senderId": { "type": "string" },
        "sourceLang": { "type": "string", "minLength": 2, "maxLength": 5 },
        "targetLang": { "type": "string", "minLength": 2, "maxLength": 5 },
        "timestamp": { "type": "integer" }
      }
    },
    "VoiceMessage": {
      "type": "object",
      "required": ["type", "messageId", "audioData", "durationMs", "timestamp"],
      "properties": {
        "type": { "const": "voice" },
        "messageId": { "type": "string", "format": "uuid" },
        "audioData": { "type": "string", "description": "base64-encoded audio" },
        "mimeType": { "type": "string", "enum": ["audio/pcm16", "audio/opus", "audio/webm"] },
        "sampleRate": { "type": "integer", "enum": [8000, 16000, 24000, 48000] },
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "timestamp": { "type": "integer" }
      }
    },
    "EditMessage": {
      "type": "object",
      "required": ["type", "messageId", "text"],
      "properties": {
        "type": { "const": "edit" },
        "messageId": { "type": "string", "format": "uuid" },
        "text": { "type": "string", "maxLength": 10000 }
      }
    },
    "DeleteMessage": {
      "type": "object",
      "required": ["type", "messageId"],
      "properties": {
        "type": { "const": "delete" },
        "messageId": { "type": "string", "format": "uuid" }
      }
    },
    "DeliveryAck": {
      "type": "object",
      "required": ["type", "messageId"],
      "properties": {
        "type": { "const": "delivery_ack" },
        "messageId": { "type": "string", "format": "uuid" }
      }
    },
    "SubtitleMessage": {
      "type": "object",
      "required": ["type", "messageId", "text", "sourceLang", "targetLang", "timestamp"],
      "properties": {
        "type": { "const": "subtitle" },
        "messageId": { "type": "string", "format": "uuid" },
        "text": { "type": "string", "maxLength": 2000 },
        "sourceLang": { "type": "string", "minLength": 2, "maxLength": 5 },
        "targetLang": { "type": "string", "minLength": 2, "maxLength": 5 },
        "senderId": { "type": "string" },
        "timestamp": { "type": "integer" }
      }
    },
    "ListenerJoinedMessage": {
      "type": "object",
      "required": ["type", "listenerId", "count"],
      "properties": {
        "type": { "const": "listener_joined" },
        "listenerId": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "ListenerLeftMessage": {
      "type": "object",
      "required": ["type", "listenerId", "count"],
      "properties": {
        "type": { "const": "listener_left" },
        "listenerId": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "ListenerKickMessage": {
      "type": "object",
      "required": ["type", "listenerId"],
      "properties": {
        "type": { "const": "listener_kick" },
        "listenerId": { "type": "string", "minLength": 1 }
      }
    },
    "ListenerKickedMessage": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "listener_kicked" }
      }
    },
    "ContactRequestMessage": {
      "type": "object",
      "required": ["type", "userId", "timestamp"],
      "properties": {
        "type": { "const": "contact_request" },
        "userId": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "maxLength": 80 },
        "agreementPublicKey": {
          "type": "string",
          "description": "base64-encoded X.509 P-256 public key for ECDH"
        },
        "timestamp": { "type": "integer" }
      }
    },
    "ContactResponseMessage": {
      "type": "object",
      "required": ["type", "userId", "accepted", "timestamp"],
      "properties": {
        "type": { "const": "contact_response" },
        "userId": { "type": "string", "minLength": 1 },
        "accepted": { "type": "boolean" },
        "timestamp": { "type": "integer" }
      }
    },
    "ErrorMessage": {
      "type": "object",
      "required": ["type", "error"],
      "properties": {
        "type": { "const": "error" },
        "error": { "type": "string" }
      }
    }
  }
}
